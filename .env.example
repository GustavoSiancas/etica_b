# Configuracion local. Completar antes de arrancar la aplicacion.

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=etical_cal
PG_USER=postgres
PG_PASSWORD=
PG_SSLMODE=disable

# Cloudflare R2: credenciales S3, no el token de la API de Cloudflare.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
# Opcional: endpoint S3 para jurisdicciones especiales. Vacio usa el account ID.
R2_ENDPOINT=
R2_PUBLIC_URL=
HTTP_ADDR=:8080

# Solo desarrollo local: habilita GET /dev/demo-data/reset
ENABLE_DEMO_RESET=false

# Solo desarrollo/pruebas: borra TODOS los registros, incluidos catalogos.
# DELETE /dev/database/clear; conserva tablas y reinicia IDs.
ENABLE_DATABASE_CLEAR=false

# Habilitar solo durante la carga inicial de participantes; luego volver a false.
# Controla POST /denunciantes y POST /denunciados. Los GET siguen disponibles.
ENABLE_INITIAL_PARTICIPANT_LOAD=false
